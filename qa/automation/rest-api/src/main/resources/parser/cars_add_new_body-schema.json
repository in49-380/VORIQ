{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "array",
  "items": [
    {
      "type": "object",
      "properties": {
        "brand": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        },
        "marketing_name": {
          "type": "string"
        },
        "displacement": {
          "type": "number"
        },
        "engine_type": {
          "type": "string"
        },
        "fuel_type": {
          "type": "string"
        },
        "transmission_type": {
          "type": "boolean"
        },
        "number_gears": {
          "type": "integer"
        },
        "drive": {
